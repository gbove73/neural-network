<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      Il livello INFO mostra la convergenza per intervalli senza produrre milioni
      di righe durante i calcoli interni eseguiti a ogni epoca.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
